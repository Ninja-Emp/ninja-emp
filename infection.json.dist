{
    "source": {
        "directories": ["src/Shared/Ledger"],
        "excludes": [
            "JournalRules.php",
            "JournalGuard.php",
            "JournalLine.php",
            "Posting.php",
            "PostedJournal.php",
            "LedgerError.php"
        ]
    },
    "logs": {
        "text": "php://stdout"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "testFrameworkOptions": "--filter MoneyTest|BarTest::testLedgerProof",
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit"
}
