# Ninja EMP — local environment.
#
# Copy to `.env` and adjust. `.env` is git-ignored; this example is committed.
#   cp .env.example .env
#
# The application reads these via getenv(); nothing is hard-coded.

# --- Database (PostgreSQL 18) ------------------------------------------------
# The API builds its PDO connection from this DSN. Leave it empty to boot the
# API without a database (health + OpenAPI still work; data endpoints 500 with a
# clear message).
NINJA_EMP_DSN="pgsql:host=127.0.0.1;port=5432;dbname=ninja_emp"
NINJA_EMP_DB_USER="postgres"
NINJA_EMP_DB_PASSWORD="postgres"

# The database the migration/backup scripts operate on.
NINJA_DB="ninja_emp"

# The demo tenant (created by db/provision.sh). Used by the functional DBAL
# tests to open a tenant-scoped connection.
NINJA_EMP_TENANT_ID="11111111-1111-7111-8111-111111111111"
NINJA_EMP_SCHEMA="tenant_demo"

# --- Application -------------------------------------------------------------
# 1 = verbose error pages with stack traces (never enable in production).
NINJA_EMP_DEBUG="1"

# --- Local ports (used by `make serve`) --------------------------------------
NINJA_API_PORT="8092"
NINJA_UI_PORT="8091"

# --- Docker (used by docker-compose.yml) -------------------------------------
NINJA_PG_PORT="5432"
