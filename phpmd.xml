<?xml version="1.0"?>
<ruleset name="Ninja EMP"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Ninja EMP static-analysis ruleset (HANDOFF.md §4, gate step 3).

        Curated from the PHPMD standard rulesets. Rules that fight the project's
        deliberate design (attribute routing, static factories, value objects,
        explicit else-branches for readability) are excluded with a reason.
    </description>

    <!-- Clean code: real smells only. -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Static factories (Money::of, Currency::usd) are intentional. -->
        <exclude name="StaticAccess"/>
        <!-- Named boolean flags are used sparingly and readably. -->
        <exclude name="BooleanArgumentFlag"/>
        <!-- Explicit else-branches are preferred for readability here. -->
        <exclude name="ElseExpression"/>
        <!-- Value objects legitimately return $this. -->
        <exclude name="UndefinedVariable"/>
    </rule>

    <!-- Size: keep methods and classes small. -->
    <rule ref="rulesets/codesize.xml">
        <!-- Data-mapping classes are naturally long but cohesive. -->
        <exclude name="ExcessiveClassComplexity"/>
        <exclude name="ExcessiveClassLength"/>
        <exclude name="ExcessiveMethodLength"/>
        <exclude name="TooManyMethods"/>
        <exclude name="TooManyPublicMethods"/>
    </rule>

    <!-- Design: coupling and inheritance hygiene. -->
    <rule ref="rulesets/design.xml">
        <!-- A repository/DBAL layer is inherently coupled to many types. -->
        <exclude name="CouplingBetweenObjects"/>
        <exclude name="NumberOfChildren"/>
        <!-- Exit expressions are used in CLI/bootstrap entry points. -->
        <exclude name="ExitExpression"/>
    </rule>

    <!-- Naming: meaningful names, but allow short loop/idiom variables. -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <exclude name="ShortMethodName"/>
    </rule>

    <!-- Unused code: dead code must go. -->
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
