includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10
    paths:
        - src
        - app
    excludePaths:
        - src/Psr
        # Server-rendered PHP templates: they consume loosely-typed view data
        # (extracted arrays) and are exercised by the functional/E2E suites,
        # not statically analysable at level 10.
        - app/tenant-ui/src/Views
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
