{
    "name": "ninja-emp/ninja-emp",
    "description": "Ninja EMP — vendor mall + consignment store SaaS. DB-first; the double-entry ledger is the source of truth.",
    "type": "project",
    "license": "proprietary",
    "keywords": ["accounting", "ledger", "consignment", "saas", "postgresql"],
    "require": {
        "php": ">=8.5",
        "ext-bcmath": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "NinjaEMP\\": "src/",
            "NinjaEmp\\Api\\": "app/api/src/",
            "NinjaEmp\\TenantUi\\": "app/tenant-ui/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NinjaEMP\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff --verbose",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "phpmd": "phpmd src text phpmd.xml",
        "deptrac": "deptrac analyse --no-progress --fail-on-uncovered",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:e2e": "phpunit --testsuite e2e",
        "test:harness": "php tests/run.php",
        "infect": "infection --threads=max --test-framework-options=\"--testsuite=unit\" --only-covering-test-cases",
        "audit:deps": "composer audit --no-dev",
        "gate": [
            "@cs",
            "@stan",
            "@phpmd",
            "@deptrac",
            "@test",
            "@infect"
        ]
    },
    "scripts-descriptions": {
        "cs": "Check code style (PSR-12) without modifying files.",
        "cs:fix": "Auto-fix code style (PSR-12).",
        "stan": "Run PHPStan at level 10.",
        "phpmd": "Run PHPMD complexity/coupling rules.",
        "deptrac": "Enforce architecture boundaries (bounded contexts).",
        "test": "Run the full PHPUnit suite (unit + end-to-end).",
        "test:unit": "Run the unit suite (the harness bridge, used by Infection).",
        "test:e2e": "Run the end-to-end suite (real front controllers over HTTP).",
        "test:harness": "Run the zero-dependency harness directly (no PHPUnit).",
        "infect": "Run mutation testing (primary gate, MSI >= 80%).",
        "audit:deps": "Audit runtime dependencies for known vulnerabilities.",
        "gate": "Run the full local quality gate in CI order."
    }
}
