#!/usr/bin/env bash
# =============================================================================
# bin/migrate — canonical entrypoint for the migration runner.
#
# Loads .env (if present) so the same connection settings the app uses are used
# here, then delegates to scripts/migrate.sh (resumable, idempotent,
# checksum-verified).
#
#   bin/migrate                 apply all pending migrations, all tenants
#   bin/migrate --status        show applied vs pending
#   bin/migrate --dry-run       show what would run
#   bin/migrate --tenant t_x    one tenant only
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$HERE/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$HERE/.env"
  set +a
fi

exec bash "$HERE/scripts/migrate.sh" "$@"
