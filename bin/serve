#!/usr/bin/env bash
# =============================================================================
# bin/serve — run the API and the Tenant UI dev servers together.
#
#   bin/serve
#
# Both front controllers are zero-dependency PHP; PHP's built-in server is all
# that is needed. Ctrl-C stops both.
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$HERE/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$HERE/.env"
  set +a
fi

PHP="${PHP:-php}"
API_PORT="${NINJA_API_PORT:-8092}"
UI_PORT="${NINJA_UI_PORT:-8091}"

echo ">> API       http://127.0.0.1:${API_PORT}   (health: /api/health, docs: /api/docs)"
echo ">> Tenant UI http://127.0.0.1:${UI_PORT}"
echo ">> Ctrl-C to stop."

trap 'kill 0' EXIT

"$PHP" -S "127.0.0.1:${API_PORT}" -t "$HERE/app/api/public" "$HERE/app/api/public/router.php" &
"$PHP" -S "127.0.0.1:${UI_PORT}" -t "$HERE/app/tenant-ui/public" "$HERE/app/tenant-ui/public/router.php" &

wait
